# Verejná adresa stránky bez lomky na konci (napr. https://darceky.relax-zilina.sk)
SITE_URL=http://localhost:3000

# --- Stripe (účet Relax Žilina) ---
# Testovacie kľúče začínajú sk_test_, ostré sk_live_
STRIPE_SECRET_KEY=sk_test_...
# Podpisový kľúč webhooku (Stripe → Developers → Webhooks → endpoint → Signing secret)
STRIPE_WEBHOOK_SECRET=whsec_...
# Sadzba DPH na faktúrach zo Stripe (ceny sú vrátane DPH). Predvolene 5 (registrovaný sociálny podnik), 0 = faktúra bez DPH.
# VAT_RATE=5

# --- Meta Pixel + Conversions API ---
NEXT_PUBLIC_META_PIXEL_ID=000000000000000
# Events Manager → Pixel → Nastavenia → Conversions API → Vygenerovať prístupový token
META_CAPI_ACCESS_TOKEN=
# Len na testovanie: kód z Events Manager → Testovať udalosti (pred spustením vymazať)
META_TEST_EVENT_CODE=
# Verzia Graph API (skontrolujte aktuálnu na developers.facebook.com)
META_API_VERSION=v23.0
# false (predvolené) = nákupy idú do Mety zo servera aj bez súhlasu s cookies (oprávnený záujem);
# true = bez súhlasu s cookies sa do Mety neposiela nič
CAPI_REQUIRE_CONSENT=false

# --- E-maily s poukážkou (cez n8n) ---
# Production URL webhooku z n8n workflowu n8n/poukazky-email.json. n8n pošle e-mail z adresy WebPointu,
# meno odosielateľa je EMAIL_FROM_NAME (predvolene názov salónu). Adresu nikde nezverejňujte.
N8N_MAIL_WEBHOOK_URL=
EMAIL_FROM_NAME=Relax Žilina
# Kam príde upozornenie o každom predaji aj s kódmi poukážok (a kam pôjdu odpovede zákazníkov)
SALON_NOTIFY_EMAIL=
# Náhrada za n8n: Brevo API kľúč a overený odosielateľ (použije sa, len keď N8N_MAIL_WEBHOOK_URL je prázdne)
BREVO_API_KEY=
EMAIL_FROM=

# --- Poukážky ---
# Tajný kľúč na generovanie kódov (ľubovoľný dlhý náhodný reťazec, po spustení nemeniť)
VOUCHER_SECRET=
VOUCHER_VALID_UNTIL=31. 3. 2027
# Platnosť Black Friday poukážok, ak má byť iná (napr. 30. 6. 2027)
BF_VALID_UNTIL=

# --- Voliteľne: n8n webhook (zápis predaja do NocoDB) ---
N8N_SALE_WEBHOOK_URL=
