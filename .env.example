# Verejná adresa stránky bez lomky na konci (napr. https://darceky.relax-zilina.sk)
SITE_URL=http://localhost:3000

# --- Stripe (účet Relax Žilina) ---
# Testovacie kľúče začínajú sk_test_, ostré sk_live_
STRIPE_SECRET_KEY=sk_test_...
# Podpisový kľúč webhooku (Stripe → Developers → Webhooks → endpoint → Signing secret)
STRIPE_WEBHOOK_SECRET=whsec_...

# --- Meta Pixel + Conversions API ---
NEXT_PUBLIC_META_PIXEL_ID=000000000000000
# Events Manager → Pixel → Nastavenia → Conversions API → Vygenerovať prístupový token
META_CAPI_ACCESS_TOKEN=
# Len na testovanie: kód z Events Manager → Testovať udalosti (pred spustením vymazať)
META_TEST_EVENT_CODE=
# Verzia Graph API (skontrolujte aktuálnu na developers.facebook.com)
META_API_VERSION=v23.0
# true = bez súhlasu s cookies neposielame do Mety nič (bezpečnejšie z pohľadu GDPR)
CAPI_REQUIRE_CONSENT=true

# --- E-maily cez Brevo ---
BREVO_API_KEY=
EMAIL_FROM=poukazky@relax-zilina.sk
EMAIL_FROM_NAME=Relax Žilina
# Kam príde upozornenie o každom predaji
SALON_NOTIFY_EMAIL=

# --- Poukážky ---
# Tajný kľúč na generovanie kódov (ľubovoľný dlhý náhodný reťazec, po spustení nemeniť)
VOUCHER_SECRET=
VOUCHER_VALID_UNTIL=31. 3. 2027

# --- Voliteľne: n8n webhook (zápis predaja do NocoDB) ---
N8N_SALE_WEBHOOK_URL=
